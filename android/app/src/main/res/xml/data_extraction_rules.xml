<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+): disable both cloud backup and device-to-device
     transfer so app data (SharedPreferences / cache) is wiped on uninstall
     and never restored on reinstall. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="false">
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
